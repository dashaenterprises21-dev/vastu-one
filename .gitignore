# ============================================================
# VASTU ONE — .gitignore
# ============================================================

# Environment (NEVER commit)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*

# Database
*.db
*.sqlite3

# Large files (keep in git-lfs if needed)
models/*.pt
models/*.pth
*.onnx

# Uploads
uploads/
temp_uploads/

# PDF test outputs
test_report.pdf
*.pdf
!docs/**/*.pdf

# Audit outputs
audit_output/
forensic_audit.py.bak

# Backup files
*.backup
*.bak
*.OLD*
.env.OLD*
.env.backup*

# Sensitive
secrets/
private/

# Temporary
tmp/
temp/
# Sensitive files
token.txt
HANDOFF.txt
SESSION_INFO.txt

# Backup files
*.backup-*
*.bak
*.bak-*
*.bak2-*
*.bak3-*
*.broken-*
*.corrupt-backup-*
*.backup-before-*
*.bak-final-*

# Generated scripts (one-time use)
add_landing_*.py
add_star.py
add_sample_*.py
add_structured_urls.py
bulk_url_update*.py
check_*.py
cleanup_modules.py
fix_*.py
mount_switcher.py
patch_*.py
reset_pwd*.py
seed_log.txt
test_url_add.py
interactive_url_add.py
generate_csv_template.py
autofill_csv.py
list_routes*.py
audit_course.py

# ============================================================
# VASTU ONE — .gitignore
# ============================================================

# Environment (NEVER commit)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*

# Database
*.db
*.sqlite3

# Large files (keep in git-lfs if needed)
models/*.pt
models/*.pth
*.onnx

# Uploads
uploads/
temp_uploads/

# PDF test outputs
test_report.pdf
*.pdf
!docs/**/*.pdf

# Audit outputs
audit_output/
forensic_audit.py.bak

# Backup files
*.backup
*.bak
*.OLD*
.env.OLD*
.env.backup*

# Sensitive
secrets/
private/

# Temporary
tmp/
temp/
# VASTU ONE - Environment Configuration
# Copy to .env and fill real values. NEVER commit .env.

# App
APP_NAME=VASTU ONE
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-this-to-random-64-char-string

# Database (Supabase)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET_KEY=generate-with-python-secrets
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email
SENDGRID_API_KEY=
FROM_EMAIL=noreply@vastuone.in

# Ephemeris
EPHE_PATH=./ephe

# YOLO
YOLO_MODEL_PATH=./models/best.pt
